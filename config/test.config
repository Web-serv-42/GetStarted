# ====================================================================
# EPOLLOS WEB SERVER - MASTER TEST CONFIGURATION
# ====================================================================

# ---------------------------------------------------------
# SERVER 1: The "Standard" Setup (Tests Inheritance)
# ---------------------------------------------------------
server {
    listen       8080;
    server_name  main.com www.main.com;
    
    # This is the fallback root for any location that forgets to define one
    root /var/www/html;
    
    client_max_body_size 50M;
    
    # Testing plural accumulation (should merge into one string)
    error_page 404 /errors/404.html;
    error_page 500 502 503 504 /errors/50x.html;

    # Edge Case 1: Pure inheritance. 
    # Should use the server's root (/var/www/html)
    location / {
        allow_methods GET;
        index index.html;
        autoindex off;
    }

    # Edge Case 2: The Override. 
    # Should IGNORE the server root and use its own.
    location /downloads {
        root /var/www/shared_files;
        allow_methods GET;
        autoindex on;
    }

    # Edge Case 3: Messy formatting and multiple methods
    location /api/ {
            allow_methods GET    POST   DELETE;
            client_max_body_size 5M;   # Overrides the server's 50M
    }
}

# ---------------------------------------------------------
# SERVER 2: Virtual Hosting (Same Port, Different Name)
# ---------------------------------------------------------
server {
    listen 8080;
    server_name backup-server.local;

    # Notice: NO server-level root defined here!

    # Edge Case 4: Location MUST provide its own root, or Router 
    # will have to fallback to a hardcoded default like "./html"
    location / {
        root /tmp/backup_site;
        autoindex on;
    }

    location /redirect_test {
        return 301 /new_location;
    }
}

# ---------------------------------------------------------
# SERVER 3: A Different Port (Isolation Test)
# ---------------------------------------------------------
server {
    listen 9090;
    server_name admin.local;
    root /var/admin_panel;

    location / {
        allow_methods GET POST;
        index login.html;
    }
    
    # Edge Case 5: CGI execution block
    location /cgi-bin {
        allow_methods GET POST;
        cgi_handler .py /usr/bin/python3;
        cgi_handler .php /usr/bin/php-cgi; # Testing accumulation again
    }
}