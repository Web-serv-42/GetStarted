
# this is a comment 
server {
    listen 8080;
    host localhost;
    root pages/nano/;
    index index.html;
    error_page 404.html;
    client_max_body_size 99999999999999999;

    # also this is a comment 
    
    location /upload {
        allow_methods GET POST;
        upload_to pages/nano/uploads;
        cgi_path cgi-bin/;
        cgi_ext .py;
    }

    location /delete {
        root pages/nano/to_delete;
        allow_methods DELETE;
    }

    location /cgi_get { 
        cgi_path cgi-bin/;
        cgi_ext .py;
    }
}

server {
    listen 8081;

    host localhost;
    root pages/nano/;
    index index.html;
    server_name www.example.com;
    error_page 404.html;
    client_max_body_size 99999999999999999;
}